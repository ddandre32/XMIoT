# 小米IoT配置

# OAuth2配置（需要在小米开放平台申请）
MIOT_CLIENT_ID=your_client_id_here
MIOT_PROJECT_CODE=your_project_code_here

# 服务器配置
CLOUD_SERVER=cn
REDIRECT_URI=http://localhost:8000/callback

# 缓存路径
CACHE_PATH=./cache

# API服务配置
API_HOST=0.0.0.0
API_PORT=8000

# MCP服务配置
MCP_HOST=0.0.0.0
MCP_PORT=8080

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
